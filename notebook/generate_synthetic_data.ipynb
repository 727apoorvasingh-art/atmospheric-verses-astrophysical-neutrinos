    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "np.random.seed(7)\n",
    "\n",
    "natm = 8000\n",
    "natp = 2000"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3d3cfc77",
   "metadata": {},
   "source": [
    "atmospheric|"
   ]
  },
