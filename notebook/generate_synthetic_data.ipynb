  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "c4f1778f",
   "metadata": {},
   "outputs": [],
   "source": [
    "energy_atp = np.random.lognormal(mean=9.5, sigma=1.5, size=natp)\n",
    "cos_zenith_atp = np.random.uniform(-1, 1, size=natp)\n",
    "zenith_atp = np.arccos(cos_zenith_atp)\n",
    "azimuth_atp = np.random.uniform(0, 2*np.pi, size=natp)\n",
    " "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "25a76881",
   "metadata": {},
   "outputs": [],
   "source": [
    "def derived_features(energy):\n",
    "    n = len(energy)\n",
    "    track_length = np.clip(50 + 40*np.log10(energy) + np.random.normal(0,30, n), 5, None)\n",
    "    dom_hits = np.clip(10 + 15*np.log10(energy) + np.random.normal(0, 10,n), 1, None).astype(int)\n",
    "    reco_quality = np.clip(0.5 +0.05*np.log10(energy) + np.random.normal(0, 0.1, n), 0, 1)\n",
    "    time_spread = np.clip(20 + 0.5*track_length + np.random.normal(0, 15, n), 1, None)\n",
    "    return track_length, dom_hits, reco_quality, time_spread\n",
    "\n",
    "track_atm, hits_atm, q_atm, ts_atm = derived_features(energy_atm)\n",
    "track_atp, hits_atp, q_atp, ts_atp = derived_features(energy_atp)\n"
   ]
  },
