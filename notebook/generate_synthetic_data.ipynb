   "metadata": {},
   "outputs": [],
   "source": [
    "energy_atm = np.random.lognormal(mean=6.5, sigma=1.2, size=natm)\n",
    "zenith_atm = np.clip(np.random.normal(loc=1.2, scale=0.6, size=natm), 0, np.pi)\n",
    "azimuth_atm = np.random.uniform(0, 2*np.pi, size=natm)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8dd99ca8",
   "metadata": {},
   "source": [
